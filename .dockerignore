# Keep Docker build context small & avoid leaking repo metadata
.git
.github
.idea
.vscode
*.iml

# Maven
**/target

# Runtime data / local state
**/data
**/*.db
**/*.mv.db
**/*.trace.db

# Logs
**/*.log

# Archives
*.zip
*.tar
*.tar.gz

# Drop EasyUI demos/sources from Docker build context (not used at runtime)
src/main/resources/static/jquery-easyui-1.9.14/demo
src/main/resources/static/jquery-easyui-1.9.14/demo-mobile
src/main/resources/static/jquery-easyui-1.9.14/src
